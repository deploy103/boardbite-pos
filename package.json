{
  "name": "boardbite-pos",
  "private": true,
  "version": "0.1.0",
  "description": "보드게임 카페형 학교 부스를 위한 테이블오더·KDS·POS·정산 시스템",
  "workspaces": [
    "server",
    "client",
    "e2e"
  ],
  "overrides": {
    "qs": "^6.16.0"
  },
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build:server": "npm run build --workspace server",
    "build:client": "npm run build --workspace client",
    "test:server": "npm run test --workspace server",
    "test:e2e": "npm run test --workspace e2e",
    "e2e:server": "node e2e/scripts/prepare-and-start.mjs",
    "prisma:migrate": "npm run prisma:migrate --workspace server",
    "prisma:seed": "npm run prisma:seed --workspace server"
  },
  "license": "MIT"
}
