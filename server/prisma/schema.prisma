// BoardBite POS — Prisma schema
// 설계 근거: docs/ARCHITECTURE.md §4, docs/adr/0003-auth-session.md, docs/adr/0004-table-token.md
//
// SQLite 커넥터는 네이티브 enum을 지원하지 않으므로(docs/adr/0001-tech-stack.md의 SQLite 채택에 따른 제약),
// 상태값은 String 컬럼 + 애플리케이션 레벨 리터럴 유니온 타입(zod 스키마)으로 검증한다.
// 허용값은 각 필드 주석에 명시한다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model StaffUser {
  id                String    @id @default(cuid())
  username          String    @unique
  passwordHash      String
  displayName       String
  role              String // ADMIN | FRONT | POS | SERVING
  isActive          Boolean   @default(true)
  mustResetPassword Boolean   @default(false)
  isBootstrap       Boolean   @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())

  // 권한/비밀번호/활성 상태가 바뀔 때마다 1씩 증가시킨다. 세션에 기록된 값과 다르면
  // 그 세션은 즉시 무효(401)로 취급한다 — 요구사항2.md §2.3 stale session 무효화.
  authVersion Int @default(1)

  // ADMIN TOTP MFA — secret은 절대 평문으로 저장하지 않고 AES-256-GCM으로 봉인해 보관한다.
  mfaEnabled         Boolean @default(false)
  mfaSecretEncrypted String?
  // 마지막으로 성공 처리한 TOTP 슬롯 번호(30초 단위 counter). 같은 슬롯 이하의 코드는
  // 다시 받아주지 않는다 — 한 번 노출된 6자리가 남은 유효시간(최대 90초) 동안 재사용되는 것을 막는다.
  mfaLastUsedCounter Int?

  openedTableSessions TableSession[]      @relation("OpenedBy")
  payments            Payment[]
  loginAttempts       LoginAttempt[]
  closingSettlements  ClosingSettlement[]

  counterSalesCreated   CounterSale[]      @relation("CounterSaleCreatedBy")
  counterSalesCancelled CounterSale[]      @relation("CounterSaleCancelledBy")
  couponBatches         CouponBatch[]
  couponRedemptions     CouponRedemption[]
}

model StaffSession {
  sid       String   @id
  data      String
  expiresAt DateTime

  @@index([expiresAt])
}

model LoginAttempt {
  id          String     @id @default(cuid())
  username    String
  succeeded   Boolean
  ip          String?
  staffUserId String?
  staffUser   StaffUser? @relation(fields: [staffUserId], references: [id])
  createdAt   DateTime   @default(now())

  @@index([username, createdAt])
  @@index([ip, createdAt])
}

model Table {
  id             String   @id @default(cuid())
  number         Int      @unique
  name           String?
  status         String   @default("AVAILABLE") // DISABLED | AVAILABLE | OPEN | SETTLING
  publicSlug     String   @unique
  sortOrder      Int      @default(0)
  ordersLocked   Boolean  @default(false) // ADMIN: 이 테이블만 신규 주문 차단(요구사항.md §13.4)
  paymentsLocked Boolean  @default(false) // ADMIN: 이 테이블만 정산 차단(요구사항.md §13.4)
  createdAt      DateTime @default(now())

  sessions TableSession[]
}

model TableSession {
  id      String @id @default(cuid())
  tableId String
  table   Table  @relation(fields: [tableId], references: [id])
  status  String @default("ACTIVE") // ACTIVE | PAID_PENDING_SERVICE | CLOSED | EXPIRED

  // 이번 세션에서만 유효한 6자리 입장 코드. 원문은 저장하지 않고 서버 키 기반 HMAC만 보관한다.
  // 물리 NFC/QR의 Table.publicSlug는 "어느 테이블인지"만 알려줄 뿐 접근 권한을 주지 않는다
  // (요구사항2.md §2.2 — 과거에 저장해둔 /t/<slug> 링크로 미래 세션에 자동 입장 금지).
  joinCodeHash     String?
  joinCodeIssuedAt DateTime?

  guestCount  Int?
  note        String?
  openedById  String
  openedBy    StaffUser @relation("OpenedBy", fields: [openedById], references: [id])
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  closeReason String?

  gameUsages     TableGameUsage[]
  orders         Order[]
  payments       Payment[]
  callRequests      StaffCallRequest[]
  deviceSessions    CustomerDeviceSession[]
  couponRedemptions CouponRedemption[]

  @@index([tableId, status])
}

/// 손님 브라우저 1대 = 1행. join code 검증에 성공했을 때만 발급되며,
/// 쿠키에는 32byte CSPRNG raw token을, DB에는 그 SHA-256 해시만 저장한다.
model CustomerDeviceSession {
  id             String       @id @default(cuid())
  tableSessionId String
  tableSession   TableSession @relation(fields: [tableSessionId], references: [id])
  tokenHash      String       @unique
  createdAt      DateTime     @default(now())
  expiresAt      DateTime
  lastSeenAt     DateTime?
  revokedAt      DateTime?

  @@index([tableSessionId])
  @@index([expiresAt])
}

model GameTimePlan {
  id       String  @id @default(cuid())
  name     String
  minutes  Int
  price    Int
  isActive Boolean @default(true)

  usages TableGameUsage[]
}

model TableGameUsage {
  id             String       @id @default(cuid())
  tableSessionId String
  tableSession   TableSession @relation(fields: [tableSessionId], references: [id])
  planId         String
  plan           GameTimePlan @relation(fields: [planId], references: [id])
  minutes        Int
  price          Int
  startedAt      DateTime     @default(now())
  endsAt         DateTime

  @@index([tableSessionId])
}

model MenuCategory {
  id        String    @id @default(cuid())
  name      String
  sortOrder Int       @default(0)
  /// 논리 삭제(요구사항.md §4). 과거 주문/결제가 참조하는 행은 절대 물리 삭제하지 않는다.
  deletedAt DateTime?

  items MenuItem[]
}

model MenuItem {
  id            String       @id @default(cuid())
  categoryId    String
  category      MenuCategory @relation(fields: [categoryId], references: [id])
  name          String
  description   String?
  price         Int
  imageUrl      String?
  isActive      Boolean      @default(true)
  isSoldOut     Boolean      @default(false)
  /// 조리가 필요한 상품인가. true면 KDS 조리 대기를 만들고 READY→수령/서빙 흐름을 탄다.
  needsCooking  Boolean      @default(true)
  /// KDS 보드에 표시하는가. needsCooking=true면 반드시 true여야 한다(서버가 모순 조합을 거부).
  /// 둘 다 false = "현장 즉시 제공" 상품(룰렛/보드게임/닌텐도 등) — 조리 대기를 만들지 않는다.
  showInKitchen Boolean      @default(true)
  /// 판매 채널(요구사항.md §4): TABLE(테이블 전용) | FRONT(FRONT 전용) | BOTH(공통).
  /// 기존 메뉴는 migration에서 BOTH로 채워 기존 테이블 판매 가능성을 그대로 유지한다.
  channel       String       @default("BOTH")
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  /// 논리 삭제. 새 판매 목록에서 사라지지만 과거 주문/결제/쿠폰 이력은 그대로 남는다.
  deletedAt     DateTime?

  optionGroups  OptionGroup[]
  orderItems    OrderItem[]
  couponTargets CouponBatchTarget[]

  @@index([categoryId])
}

model OptionGroup {
  id          String    @id @default(cuid())
  menuItemId  String
  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id])
  name        String
  required    Boolean   @default(false)
  multiSelect Boolean   @default(false)
  sortOrder   Int       @default(0)
  /// 비활성 그룹은 새 주문에서 표시/검증 대상이 아니다(필수 규칙도 적용하지 않는다).
  isActive    Boolean   @default(true)
  /// 논리 삭제. 삭제한 그룹의 필수 규칙은 새 주문에 적용하지 않는다(요구사항.md §3.1).
  deletedAt   DateTime?

  choices OptionChoice[]

  @@index([menuItemId])
}

model OptionChoice {
  id         String      @id @default(cuid())
  groupId    String
  group      OptionGroup @relation(fields: [groupId], references: [id])
  name       String
  extraPrice Int         @default(0)
  isActive   Boolean     @default(true)
  sortOrder  Int         @default(0)
  deletedAt  DateTime?

  orderItemOptions OrderItemOption[]

  @@index([groupId])
}

/// 주문 소유자는 TableSession(테이블 후불) 또는 CounterSale(FRONT 현장 결제) **둘 중 정확히 하나**다.
/// 가짜 TableSession을 만들지 않기 위한 구조이며, migration SQL에 CHECK 제약으로 못박아 두었다
/// (요구사항.md §8, §12.1 — "정확히 하나만 존재하도록 데이터/서버 제약을 설계한다").
model Order {
  id             String        @id @default(cuid())
  tableSessionId String?
  tableSession   TableSession? @relation(fields: [tableSessionId], references: [id])
  counterSaleId  String?
  counterSale    CounterSale?  @relation(fields: [counterSaleId], references: [id])
  status         String        @default("NEW") // NEW | ACCEPTED | PREPARING | READY | SERVED | REJECTED | CANCELLED
  idempotencyKey String        @unique
  note           String?
  rejectReason   String?
  cancelReason   String?
  createdAt      DateTime      @default(now())
  acceptedAt     DateTime?
  preparingAt    DateTime?
  readyAt        DateTime?
  servedAt       DateTime?
  cancelledAt    DateTime?

  items OrderItem[]

  @@index([tableSessionId, status])
  @@index([counterSaleId])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id])
  menuItemId   String
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id])
  nameSnapshot String
  unitPrice    Int
  quantity     Int
  /// 주문 시점의 제공 방식 스냅샷: KITCHEN(주방 조리/전달) | COUNTER(현장 즉시 제공).
  /// 기존 행은 migration에서 KITCHEN으로 채운다 — 지금까지의 모든 주문이 주방을 거쳤다.
  servingMode  String   @default("KITCHEN")

  options     OrderItemOption[]
  allocations PaymentAllocation[]

  @@index([orderId])
}

model OrderItemOption {
  id                 String       @id @default(cuid())
  orderItemId        String
  orderItem          OrderItem    @relation(fields: [orderItemId], references: [id])
  optionChoiceId     String
  optionChoice       OptionChoice @relation(fields: [optionChoiceId], references: [id])
  /// 주문 시점의 옵션 그룹명. 기존 행은 NULL로 남긴다 —
  /// 지금의 그룹명을 과거 주문에 소급해 채우면 "그때 그 이름"을 지어내는 것이 되기 때문이다(요구사항.md §3.2).
  groupNameSnapshot  String?
  nameSnapshot       String
  extraPriceSnapshot Int

  @@index([orderItemId])
}

/// Order와 동일하게 소유자는 TableSession 또는 CounterSale 중 정확히 하나다(migration의 CHECK 제약).
model Payment {
  id                String        @id @default(cuid())
  tableSessionId    String?
  tableSession      TableSession? @relation(fields: [tableSessionId], references: [id])
  counterSaleId     String?
  counterSale       CounterSale?  @relation(fields: [counterSaleId], references: [id])
  kind              String // CHARGE | DISCOUNT | VOID | REFUND
  method            String // PaymentMethod.code (CASH | CARD | OTHER | ADMIN 정의 확장)
  amount            Int // 실제 정산액에 반영되는 금액(항상 양수, kind로 부호 의미 구분)
  tenderedAmount    Int? // 현금 결제 시 "받은 금액"(영수증 표시용, 정산액과 다를 수 있음)
  changeAmount      Int? // 현금 결제 시 거스름돈 = tenderedAmount - amount
  payerLabel        String?
  reversedPaymentId String?
  reversedPayment   Payment?      @relation("PaymentReversal", fields: [reversedPaymentId], references: [id])
  reversals         Payment[]     @relation("PaymentReversal")
  reason            String?
  idempotencyKey    String        @unique
  createdById       String
  createdBy         StaffUser     @relation(fields: [createdById], references: [id])
  createdAt         DateTime      @default(now())

  allocations PaymentAllocation[]

  @@index([tableSessionId])
  @@index([counterSaleId])
  @@index([createdAt])
}

model PaymentMethod {
  id        String  @id @default(cuid())
  code      String  @unique // "CASH" | "CARD" | "OTHER" | ADMIN이 추가한 코드
  name      String
  isCash    Boolean @default(false) // true인 결제수단만 받은금액/거스름돈 계산이 적용됨
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
}

model OperationSettings {
  // 싱글턴 행(id=1 고정). docs/ARCHITECTURE.md §9 "운영 설정" 참고.
  id                        Int      @id @default(1)
  orderingEnabled           Boolean  @default(true) // 전체 주문 기능 활성/비활성 (요구사항.md §19 "운영 모드")
  paymentsEnabled           Boolean  @default(true) // 전체 결제 기능 활성/비활성
  kdsWarnAfterSeconds       Int      @default(300) // KDS 카드 "임박" 배지 기준(초) — 기본 5분
  kdsDangerAfterSeconds     Int      @default(600) // KDS 카드 "지연" 배지 기준(초) — 기본 10분
  servedRevertWindowSeconds Int      @default(180) // SERVING "서빙완료 되돌리기" 권한 없이 허용되는 시간(초) — 기본 3분
  updatedAt                 DateTime @updatedAt
}

model PaymentAllocation {
  id          String    @id @default(cuid())
  paymentId   String
  payment     Payment   @relation(fields: [paymentId], references: [id])
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  quantity    Int
  amount      Int

  @@index([orderItemId])
  @@index([paymentId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorType   String // STAFF | SYSTEM
  actorId     String?
  action      String // ORDER_CREATED, PAYMENT_VOIDED, ... (요구사항.md §14)
  targetType  String?
  targetId    String?
  metadata    String? // JSON string (민감정보 제외)
  prevHash    String
  hash        String
  // 1 = 레거시 SHA-256 체인, 2 = HMAC-SHA256(AUDIT_HMAC_KEY) 체인(요구사항2.md §5.2).
  // 기존 v1 레코드는 그대로 검증 가능하게 두고, 신규 레코드만 v2로 기록한다.
  hashVersion Int      @default(1)
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
}

/// 영업 마감 정산 스냅샷(요구사항2.md §9.1). 한 번 기록되면 수정하지 않는다 —
/// 정정이 필요하면 새 마감 레코드를 추가하고 note로 사유를 남긴다.
model ClosingSettlement {
  id             String    @id @default(cuid())
  openedAt       DateTime
  closedAt       DateTime
  expectedCash   Int
  actualCash     Int
  cashDifference Int
  totalRevenue   Int
  totalDiscount  Int
  totalRefund    Int
  totalVoid      Int
  closedById     String
  closedBy       StaffUser @relation(fields: [closedById], references: [id])
  note           String?
  /// 마감 시점의 상세 집계(결제수단별 매출, 미정산/강제종료 테이블 등) JSON 스냅샷.
  snapshot       String
  createdAt      DateTime  @default(now())

  @@index([closedAt])
}

model StaffCallRequest {
  id             String       @id @default(cuid())
  tableSessionId String
  tableSession   TableSession @relation(fields: [tableSessionId], references: [id])
  status         String       @default("PENDING") // PENDING | ACKED | DONE
  createdAt      DateTime     @default(now())
  ackedAt        DateTime?
  doneAt         DateTime?

  @@index([tableSessionId, status])
}

// ---------------------------------------------------------------------------
// FRONT 현장 결제 (요구사항.md §5, §12.1)
//
// 테이블을 열지 않고 카운터에서 바로 수납을 기록하는 거래. 가짜 Table/TableSession을
// 만들지 않기 위해 별도 헤더 모델을 두고, 금액 원본은 기존 Order/OrderItem/Payment
// 원장을 그대로 재사용한다(중복 원장을 만들지 않는다).
// ---------------------------------------------------------------------------
model CounterSale {
  id     String @id @default(cuid())
  /// 사람이 읽고 부르는 주문번호. 전체에서 유일하며 재사용하지 않는다.
  saleNo Int    @unique
  status String @default("COMPLETED") // COMPLETED | CANCELLED

  createdById String
  createdBy   StaffUser @relation("CounterSaleCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  cancelledById String?
  cancelledBy   StaffUser? @relation("CounterSaleCancelledBy", fields: [cancelledById], references: [id])
  cancelledAt   DateTime?
  cancelReason  String?

  /// 확정 요청 멱등 키(직원 세션 범위로 좁혀 저장). 같은 키 + 같은 requestHash면 최초 결과를
  /// 그대로 돌려주고, 같은 키 + 다른 본문이면 409로 거부한다(요구사항.md §6.3).
  idempotencyKey String @unique
  requestHash    String

  orders      Order[]
  payments    Payment[]
  redemptions CouponRedemption[]

  @@index([createdAt])
  @@index([status])
}

// ---------------------------------------------------------------------------
// 쿠폰 (요구사항.md §6)
//
// CouponBatch(혜택 정의) → Coupon(고유 번호 001~999 / 1회 사용 상태)
//   → CouponRedemption(실제 할인액·거래·직원)
//
// 실제 할인 금액은 기존 Payment(kind=DISCOUNT, method=COUPON) 원장에 한 번만 기록하고,
// CouponRedemption은 "어느 쿠폰이 어느 거래에 얼마로 쓰였는가"를 가리키는 연결 기록이다.
// ---------------------------------------------------------------------------
model CouponBatch {
  id        String    @id @default(cuid())
  /// AMOUNT(금액권) | ITEM(상품권)
  type      String
  name      String
  memo      String?
  /// AMOUNT권의 권면 금액(원). ITEM권은 null.
  amount    Int?
  /// 만료 시각(서버 시간 기준). null이면 무기한.
  expiresAt DateTime?

  issuedCount    Int
  /// 배치 발급 멱등 키 — 같은 요청을 재전송해도 쿠폰이 두 번 발급되지 않는다.
  idempotencyKey String @unique

  createdById String
  createdBy   StaffUser @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  targets CouponBatchTarget[]
  coupons Coupon[]

  @@index([createdAt])
}

/// ITEM(상품권)이 무료로 제공하는 대상 메뉴. 동명 다른 메뉴에 적용되지 않도록 항상 ID로 검증한다.
model CouponBatchTarget {
  id           String      @id @default(cuid())
  batchId      String
  batch        CouponBatch @relation(fields: [batchId], references: [id])
  menuItemId   String
  menuItem     MenuItem    @relation(fields: [menuItemId], references: [id])
  /// 발급 시점의 메뉴명. 대상 메뉴가 나중에 삭제/개명돼도 쿠폰에 적힌 혜택을 그대로 보여준다.
  nameSnapshot String

  @@unique([batchId, menuItemId])
  @@index([menuItemId])
}

model Coupon {
  id      String      @id @default(cuid())
  batchId String
  batch   CouponBatch @relation(fields: [batchId], references: [id])
  /// 001~999 (3자리 0채움, 000 금지). 전체에서 유일하며 절대 재사용하지 않는다.
  code    String      @unique
  /// AVAILABLE | USED | CANCELLED. "유효기간 만료"는 batch.expiresAt으로 파생 판정한다.
  status  String      @default("AVAILABLE")

  usedAt      DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  redemptions CouponRedemption[]

  @@index([status])
  @@index([batchId])
}

model CouponRedemption {
  id       String @id @default(cuid())
  /// 쿠폰 1장은 평생 1회만 사용된다 — UNIQUE로 이중 사용을 DB 레벨에서 못박는다.
  couponId String @unique
  coupon   Coupon @relation(fields: [couponId], references: [id])

  /// 사용처는 FRONT 현장 거래 또는 테이블 후불 정산 중 **정확히 하나**다(migration의 CHECK 제약).
  /// Order/Payment의 소유자 규칙과 같은 모양을 유지해 집계·환불 로직이 한 갈래로 흐르게 한다.
  counterSaleId String?
  counterSale   CounterSale? @relation(fields: [counterSaleId], references: [id])
  tableSessionId String?
  tableSession   TableSession? @relation(fields: [tableSessionId], references: [id])

  /// 할인 전 거래 금액과 실제 적용된 할인액.
  originalAmount    Int
  discountAmount    Int
  /// ITEM권이 적용된 주문 항목/메뉴(금액권은 null).
  targetOrderItemId String?
  targetMenuItemId  String?
  /// 사용 시점의 혜택 스냅샷(JSON) — 배치가 나중에 어떻게 보이든 "그때 무엇을 줬는지"가 남는다.
  benefitSnapshot   String

  redeemedById String
  redeemedBy   StaffUser @relation(fields: [redeemedById], references: [id])
  redeemedAt   DateTime  @default(now())
  /// 거래 취소/환불로 제공 실적이 취소된 시각. 쿠폰 자체는 사용 완료로 유지된다(요구사항.md §6.4).
  cancelledAt  DateTime?

  @@index([counterSaleId])
  @@index([tableSessionId])
  @@index([redeemedAt])
}
