// BoardBite POS — Prisma schema
// 설계 근거: docs/ARCHITECTURE.md §4, docs/adr/0003-auth-session.md, docs/adr/0004-table-token.md
//
// SQLite 커넥터는 네이티브 enum을 지원하지 않으므로(docs/adr/0001-tech-stack.md의 SQLite 채택에 따른 제약),
// 상태값은 String 컬럼 + 애플리케이션 레벨 리터럴 유니온 타입(zod 스키마)으로 검증한다.
// 허용값은 각 필드 주석에 명시한다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model StaffUser {
  id                String    @id @default(cuid())
  username          String    @unique
  passwordHash      String
  displayName       String
  role              String // ADMIN | FRONT | POS | SERVING
  isActive          Boolean   @default(true)
  mustResetPassword Boolean   @default(false)
  isBootstrap       Boolean   @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())

  // 권한/비밀번호/활성 상태가 바뀔 때마다 1씩 증가시킨다. 세션에 기록된 값과 다르면
  // 그 세션은 즉시 무효(401)로 취급한다 — 요구사항2.md §2.3 stale session 무효화.
  authVersion Int @default(1)

  // ADMIN TOTP MFA — secret은 절대 평문으로 저장하지 않고 AES-256-GCM으로 봉인해 보관한다.
  mfaEnabled         Boolean @default(false)
  mfaSecretEncrypted String?

  openedTableSessions TableSession[]      @relation("OpenedBy")
  payments            Payment[]
  loginAttempts       LoginAttempt[]
  closingSettlements  ClosingSettlement[]
}

model StaffSession {
  sid       String   @id
  data      String
  expiresAt DateTime

  @@index([expiresAt])
}

model LoginAttempt {
  id          String     @id @default(cuid())
  username    String
  succeeded   Boolean
  ip          String?
  staffUserId String?
  staffUser   StaffUser? @relation(fields: [staffUserId], references: [id])
  createdAt   DateTime   @default(now())

  @@index([username, createdAt])
  @@index([ip, createdAt])
}

model Table {
  id             String   @id @default(cuid())
  number         Int      @unique
  name           String?
  status         String   @default("AVAILABLE") // DISABLED | AVAILABLE | OPEN | SETTLING
  publicSlug     String   @unique
  sortOrder      Int      @default(0)
  ordersLocked   Boolean  @default(false) // ADMIN: 이 테이블만 신규 주문 차단(요구사항.md §13.4)
  paymentsLocked Boolean  @default(false) // ADMIN: 이 테이블만 정산 차단(요구사항.md §13.4)
  createdAt      DateTime @default(now())

  sessions TableSession[]
}

model TableSession {
  id     String @id @default(cuid())
  tableId String
  table   Table  @relation(fields: [tableId], references: [id])
  status  String @default("ACTIVE") // ACTIVE | PAID_PENDING_SERVICE | CLOSED | EXPIRED

  // 이번 세션에서만 유효한 6자리 입장 코드. 원문은 저장하지 않고 서버 키 기반 HMAC만 보관한다.
  // 물리 NFC/QR의 Table.publicSlug는 "어느 테이블인지"만 알려줄 뿐 접근 권한을 주지 않는다
  // (요구사항2.md §2.2 — 과거에 저장해둔 /t/<slug> 링크로 미래 세션에 자동 입장 금지).
  joinCodeHash     String?
  joinCodeIssuedAt DateTime?

  guestCount  Int?
  note        String?
  openedById  String
  openedBy    StaffUser @relation("OpenedBy", fields: [openedById], references: [id])
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  closeReason String?

  gameUsages     TableGameUsage[]
  orders         Order[]
  payments       Payment[]
  callRequests   StaffCallRequest[]
  deviceSessions CustomerDeviceSession[]

  @@index([tableId, status])
}

/// 손님 브라우저 1대 = 1행. join code 검증에 성공했을 때만 발급되며,
/// 쿠키에는 32byte CSPRNG raw token을, DB에는 그 SHA-256 해시만 저장한다.
model CustomerDeviceSession {
  id             String       @id @default(cuid())
  tableSessionId String
  tableSession   TableSession @relation(fields: [tableSessionId], references: [id])
  tokenHash      String       @unique
  createdAt      DateTime     @default(now())
  expiresAt      DateTime
  lastSeenAt     DateTime?
  revokedAt      DateTime?

  @@index([tableSessionId])
  @@index([expiresAt])
}

model GameTimePlan {
  id       String  @id @default(cuid())
  name     String
  minutes  Int
  price    Int
  isActive Boolean @default(true)

  usages TableGameUsage[]
}

model TableGameUsage {
  id             String       @id @default(cuid())
  tableSessionId String
  tableSession   TableSession @relation(fields: [tableSessionId], references: [id])
  planId         String
  plan           GameTimePlan @relation(fields: [planId], references: [id])
  minutes        Int
  price          Int
  startedAt      DateTime     @default(now())
  endsAt         DateTime

  @@index([tableSessionId])
}

model MenuCategory {
  id        String @id @default(cuid())
  name      String
  sortOrder Int    @default(0)

  items MenuItem[]
}

model MenuItem {
  id            String       @id @default(cuid())
  categoryId    String
  category      MenuCategory @relation(fields: [categoryId], references: [id])
  name          String
  description   String?
  price         Int
  imageUrl      String?
  isActive      Boolean      @default(true)
  isSoldOut     Boolean      @default(false)
  needsCooking  Boolean      @default(true)
  showInKitchen Boolean      @default(true)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())

  optionGroups OptionGroup[]
  orderItems   OrderItem[]

  @@index([categoryId])
}

model OptionGroup {
  id          String   @id @default(cuid())
  menuItemId  String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])
  name        String
  required    Boolean  @default(false)
  multiSelect Boolean  @default(false)
  sortOrder   Int      @default(0)

  choices OptionChoice[]

  @@index([menuItemId])
}

model OptionChoice {
  id         String      @id @default(cuid())
  groupId    String
  group      OptionGroup @relation(fields: [groupId], references: [id])
  name       String
  extraPrice Int         @default(0)
  isActive   Boolean     @default(true)
  sortOrder  Int         @default(0)

  orderItemOptions OrderItemOption[]

  @@index([groupId])
}

model Order {
  id             String    @id @default(cuid())
  tableSessionId String
  tableSession   TableSession @relation(fields: [tableSessionId], references: [id])
  status         String    @default("NEW") // NEW | ACCEPTED | PREPARING | READY | SERVED | REJECTED | CANCELLED
  idempotencyKey String    @unique
  note           String?
  rejectReason   String?
  cancelReason   String?
  createdAt      DateTime  @default(now())
  acceptedAt     DateTime?
  preparingAt    DateTime?
  readyAt        DateTime?
  servedAt       DateTime?
  cancelledAt    DateTime?

  items OrderItem[]

  @@index([tableSessionId, status])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id])
  menuItemId   String
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id])
  nameSnapshot String
  unitPrice    Int
  quantity     Int

  options     OrderItemOption[]
  allocations PaymentAllocation[]

  @@index([orderId])
}

model OrderItemOption {
  id                 String       @id @default(cuid())
  orderItemId        String
  orderItem          OrderItem    @relation(fields: [orderItemId], references: [id])
  optionChoiceId     String
  optionChoice       OptionChoice @relation(fields: [optionChoiceId], references: [id])
  nameSnapshot       String
  extraPriceSnapshot Int

  @@index([orderItemId])
}

model Payment {
  id                String       @id @default(cuid())
  tableSessionId    String
  tableSession      TableSession @relation(fields: [tableSessionId], references: [id])
  kind              String // CHARGE | DISCOUNT | VOID | REFUND
  method            String // PaymentMethod.code (CASH | CARD | OTHER | ADMIN 정의 확장)
  amount            Int // 실제 정산액에 반영되는 금액(항상 양수, kind로 부호 의미 구분)
  tenderedAmount    Int? // 현금 결제 시 "받은 금액"(영수증 표시용, 정산액과 다를 수 있음)
  changeAmount      Int? // 현금 결제 시 거스름돈 = tenderedAmount - amount
  payerLabel        String?
  reversedPaymentId String?
  reversedPayment   Payment?     @relation("PaymentReversal", fields: [reversedPaymentId], references: [id])
  reversals         Payment[]    @relation("PaymentReversal")
  reason            String?
  idempotencyKey    String       @unique
  createdById       String
  createdBy         StaffUser    @relation(fields: [createdById], references: [id])
  createdAt         DateTime     @default(now())

  allocations PaymentAllocation[]

  @@index([tableSessionId])
}

model PaymentMethod {
  id        String  @id @default(cuid())
  code      String  @unique // "CASH" | "CARD" | "OTHER" | ADMIN이 추가한 코드
  name      String
  isCash    Boolean @default(false) // true인 결제수단만 받은금액/거스름돈 계산이 적용됨
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
}

model OperationSettings {
  // 싱글턴 행(id=1 고정). docs/ARCHITECTURE.md §9 "운영 설정" 참고.
  id                    Int      @id @default(1)
  orderingEnabled       Boolean  @default(true) // 전체 주문 기능 활성/비활성 (요구사항.md §19 "운영 모드")
  paymentsEnabled       Boolean  @default(true) // 전체 결제 기능 활성/비활성
  kdsWarnAfterSeconds   Int      @default(300) // KDS 카드 "임박" 배지 기준(초) — 기본 5분
  kdsDangerAfterSeconds Int      @default(600) // KDS 카드 "지연" 배지 기준(초) — 기본 10분
  servedRevertWindowSeconds Int  @default(180) // SERVING "서빙완료 되돌리기" 권한 없이 허용되는 시간(초) — 기본 3분
  updatedAt             DateTime @updatedAt
}

model PaymentAllocation {
  id          String    @id @default(cuid())
  paymentId   String
  payment     Payment   @relation(fields: [paymentId], references: [id])
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  quantity    Int
  amount      Int

  @@index([orderItemId])
  @@index([paymentId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorType  String // STAFF | SYSTEM
  actorId    String?
  action     String // ORDER_CREATED, PAYMENT_VOIDED, ... (요구사항.md §14)
  targetType String?
  targetId   String?
  metadata   String? // JSON string (민감정보 제외)
  prevHash   String
  hash       String
  // 1 = 레거시 SHA-256 체인, 2 = HMAC-SHA256(AUDIT_HMAC_KEY) 체인(요구사항2.md §5.2).
  // 기존 v1 레코드는 그대로 검증 가능하게 두고, 신규 레코드만 v2로 기록한다.
  hashVersion Int      @default(1)
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
}

/// 영업 마감 정산 스냅샷(요구사항2.md §9.1). 한 번 기록되면 수정하지 않는다 —
/// 정정이 필요하면 새 마감 레코드를 추가하고 note로 사유를 남긴다.
model ClosingSettlement {
  id             String   @id @default(cuid())
  openedAt       DateTime
  closedAt       DateTime
  expectedCash   Int
  actualCash     Int
  cashDifference Int
  totalRevenue   Int
  totalDiscount  Int
  totalRefund    Int
  totalVoid      Int
  closedById     String
  closedBy       StaffUser @relation(fields: [closedById], references: [id])
  note           String?
  /// 마감 시점의 상세 집계(결제수단별 매출, 미정산/강제종료 테이블 등) JSON 스냅샷.
  snapshot       String
  createdAt      DateTime  @default(now())

  @@index([closedAt])
}

model StaffCallRequest {
  id             String       @id @default(cuid())
  tableSessionId String
  tableSession   TableSession @relation(fields: [tableSessionId], references: [id])
  status         String       @default("PENDING") // PENDING | ACKED | DONE
  createdAt      DateTime     @default(now())
  ackedAt        DateTime?
  doneAt         DateTime?

  @@index([tableSessionId, status])
}
