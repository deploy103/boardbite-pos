# BoardBite POS - 환경변수 예시 파일
# 실제 값이 들어간 .env 파일은 절대 커밋하지 않는다.

# ---- 부트스트랩 직원 계정 (최초 1회 시드용) ----
ADMINID=admin
ADMINPASSWORD=change-me

FRONTID=front
FRONTPW=change-me

POSID=pos
POSPW=change-me

SERVING_ID=serving
SERVING_PW=change-me

# ---- 세션 ----
SESSION_SECRET=change-me

# ---- 서버 ----
PORT=3000
NODE_ENV=development

# ---- 데이터베이스 ----
# SQLite 파일 경로. server/prisma/schema.prisma 기준 상대경로로 해석됨(docs/adr/0001-tech-stack.md)
# connection_limit=1은 필수: 결제 등 금액 관련 트랜잭션의 동시성 제어 방식이다(docs/adr/0005-sqlite-write-concurrency.md 참고).
DATABASE_URL="file:./dev.db?connection_limit=1"
