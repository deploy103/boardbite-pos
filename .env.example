# BoardBite POS - 환경변수 예시 파일
# 실제 값이 들어간 .env 파일은 절대 커밋하지 않는다.
#
# production 기동 시 server/src/env.ts의 assertProductionEnv()가 아래 값들을 검사하고,
# 하나라도 기준을 못 넘기면 서버가 아예 뜨지 않는다(요구사항2.md §7.3).
#
# 강한 랜덤값 생성:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# ---- 부트스트랩 직원 계정 (최초 1회 시드용) ----
# production 규칙: 15자 이상, `change-me` 류 금지, 아이디와 동일 금지,
#                  네 계정이 서로 다른 비밀번호를 사용할 것.
# 행사 전에 개인별 계정을 만들고 이 부트스트랩 계정들은 비활성화하는 것을 권장한다.
ADMINID=admin
ADMINPASSWORD=change-me

FRONTID=front
FRONTPW=change-me

POSID=pos
POSPW=change-me

SERVING_ID=serving
SERVING_PW=change-me

# ---- 보안 키 (production 필수, 각각 32자 이상) ----
# 세션 쿠키 서명 키. 바꾸면 기존 로그인 세션이 전부 무효화된다.
SESSION_SECRET=change-me

# 감사 로그 HMAC 체인 키(요구사항2.md §5.2).
# DB에 저장하지 않는다 — 이 값이 없으면 DB 수정 권한자가 로그 체인을 재계산할 수 있다.
# 분실하면 기존 로그의 무결성 검증이 불가능해지므로 안전한 곳에 따로 보관할 것.
AUDIT_HMAC_KEY=

# TOTP(2단계 인증) secret 봉인용 AES-256-GCM 키(요구사항2.md §2.5.1).
# 분실하면 모든 관리자가 인증 앱을 다시 등록해야 한다.
MFA_ENCRYPTION_KEY=

# ---- 서버 ----
# 아래 PORT/NODE_ENV/DATABASE_URL 3개는 `npm run dev:server` 등 로컬 실행에서만 쓰인다.
# Docker(docker-compose.yml)로 띄울 때는 이 3개를 docker-compose.yml의 environment가
# 항상 덮어쓰므로(NODE_ENV=production 고정, DB는 볼륨 경로 고정) 여기 값을 안 바꿔도 된다.
PORT=3000
NODE_ENV=development

# Docker로 띄울 때 호스트에 노출할 포트(컨테이너 내부는 항상 3000).
# 기본 바인딩 주소는 127.0.0.1이라 외부에서 직접 붙을 수 없다 — 앞단 Nginx가 이 포트로 proxy_pass한다.
# 프록시 없이 외부에 직접 공개해야 한다면 HOST_BIND=0.0.0.0으로 바꾸되 HTTPS/방화벽을 직접 책임져야 한다.
HOST_PORT=3000
# HOST_BIND=127.0.0.1

# ---- Rate limit (선택) ----
# 손님 수십 명이 같은 공유기(=같은 공인 IP)를 쓰는 환경에서 기본값이 빡빡하면 올린다.
# 입장 코드 무차별 대입 제한(테이블별 10회/10분)은 이 값과 무관하게 항상 고정이다.
# CUSTOMER_RATE_LIMIT_PER_MIN=60
# STAFF_LOGIN_RATE_LIMIT_PER_5MIN=20

# ---- 데이터베이스 ----
# SQLite 파일 경로. server/prisma/schema.prisma 기준 상대경로로 해석됨(docs/adr/0001-tech-stack.md)
# connection_limit=1은 필수: 결제 등 금액 관련 트랜잭션의 동시성 제어 방식이다(docs/adr/0005-sqlite-write-concurrency.md 참고).
DATABASE_URL="file:./dev.db?connection_limit=1"
