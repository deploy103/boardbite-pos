# BoardBite POS - 환경변수 예시 파일
# 실제 값이 들어간 .env 파일은 절대 커밋하지 않는다.

# ---- 부트스트랩 직원 계정 (최초 1회 시드용) ----
ADMINID=admin
ADMINPASSWORD=change-me

FRONTID=front
FRONTPW=change-me

POSID=pos
POSPW=change-me

SERVING_ID=serving
SERVING_PW=change-me

# ---- 세션 ----
SESSION_SECRET=change-me

# ---- 서버 ----
# 아래 PORT/NODE_ENV/DATABASE_URL 3개는 `npm run dev:server` 등 로컬 실행에서만 쓰인다.
# Docker(docker-compose.yml)로 띄울 때는 이 3개를 docker-compose.yml의 environment가
# 항상 덮어쓰므로(NODE_ENV=production 고정, DB는 볼륨 경로 고정) 여기 값을 안 바꿔도 된다.
# 자세한 배포 절차는 docs/DEPLOYMENT.md 참고.
PORT=3000
NODE_ENV=development

# Docker로 띄울 때 호스트에 노출할 포트(컨테이너 내부는 항상 3000). 앞단 Nginx가 이 포트로 proxy_pass한다.
HOST_PORT=3000

# ---- 데이터베이스 ----
# SQLite 파일 경로. server/prisma/schema.prisma 기준 상대경로로 해석됨(docs/adr/0001-tech-stack.md)
# connection_limit=1은 필수: 결제 등 금액 관련 트랜잭션의 동시성 제어 방식이다(docs/adr/0005-sqlite-write-concurrency.md 참고).
DATABASE_URL="file:./dev.db?connection_limit=1"
